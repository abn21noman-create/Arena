# ============================================
# Docker ignore file
# ============================================
# Files/folders NOT to include in Docker image
# (reduces build context size and improves build speed)

# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
.next
out
build
dist

# Testing
coverage
.nyc_output

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (use .env in production via Docker secrets/variables)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE / Editor
.vscode
.idea
*.swp
*.swo
.DS_Store

# Git
.git
.gitignore
.gitattributes

# Documentation (keep in repo but not in image)
README.md
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
LICENSE
docs/
*.md
!README.md  # Exception: keep README

# Test files
__tests__
test
tests
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
jest.config.*
vitest.config.*

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Docker (avoid recursion)
Dockerfile
.dockerignore
docker-compose*.yml

# Development and maintenance scripts
scripts/

# Misc
.cache
.parcel-cache
.eslintcache
.prettierrc
.DS_Store
*.pem
.idea/
.vscode/
coverage/
*.tsbuildinfo
next-env.d.ts
