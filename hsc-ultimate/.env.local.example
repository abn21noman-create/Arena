# ============================================
# HSC Ultimate - Environment Variables Template
# এই ফাইলটা কপি করে .env.local বানিয়ে আসল ভ্যালু বসান
# cp .env.local.example .env.local
# ============================================

# ---- Database ----
# ডেভেলপমেন্টে SQLite (দ্রুত, সেটআপ লাগে না):
DATABASE_URL="file:./dev.db"
# Production এ PostgreSQL/Supabase ব্যবহার করতে চাইলে prisma/schema.prisma এ
# provider = "postgresql" করে নিচের ফরম্যাট ব্যবহার করুন:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ---- NextAuth ----
# Generate করুন: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public privacy/data-request inbox; required before public launch.
PRIVACY_CONTACT_EMAIL=""

# ---- AI Providers (Multi-provider fallback chain) ----
GROQ_API_KEY=""
MISTRAL_API_KEY=""
CEREBRAS_API_KEY=""
OPENROUTER_API_KEY=""

# ---- Email (Resend — Forgot Password রিসেট লিংক পাঠানোর জন্য) ----
# resend.com এ ফ্রি অ্যাকাউন্ট বানিয়ে API Keys সেকশন থেকে key নিন (format: re_xxxxx)
RESEND_API_KEY=""

# ---- Optional Native Android FCM (remote Strict Focus) ----
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ---- Scheduled Focus Cron ----
# Local development can use lazy mode; production should use external.
CRON_SECRET=""
FOCUS_SCHEDULER_MODE="lazy"
FOCUS_SCHEDULER_STALE_AFTER_SECONDS="180"
FOCUS_SCHEDULER_LEASE_SECONDS="120"

# ---- Optional distributed rate limiting (Upstash Redis REST) ----
# auto = Redis only when both credentials exist; otherwise local memory.
RATE_LIMIT_BACKEND="auto"
RATE_LIMIT_REDIS_TIMEOUT_MS="800"
# UPSTASH_REDIS_REST_URL="https://YOUR-DATABASE.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""
