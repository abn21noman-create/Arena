# ============================================
# HSC Ultimate - Environment Variables Template
# ============================================
# এই ফাইলটা .env.example — production deployment-এর জন্য reference
# .env (Prisma CLI) এবং .env.local (Next.js runtime) দুটোতেই values বসান
# ============================================

# ========== Database ==========
# Supabase PostgreSQL (recommended for production)
# Get from: Supabase Dashboard → Project Settings → Database → Connection String
# Two URLs needed:
#   - DATABASE_URL: Pooled connection (PgBouncer transaction mode, port 6543)
#   - DIRECT_URL: Direct connection (port 5432, for migrations only)

# Production example:
DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Local development (SQLite):
# DATABASE_URL="file:./dev.db"

# ========== NextAuth.js ==========
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Set true only behind a trusted reverse proxy/container platform.
AUTH_TRUST_HOST="false"  # Production: https://yourdomain.com

# ========== AI Providers (Multi-provider fallback chain) ==========
# At minimum, configure ONE provider. More = better fallback.
# All have free tiers.

# Groq (PRIMARY — fastest, most reliable) — https://console.groq.com/keys
GROQ_API_KEY=""

# Mistral AI (SECONDARY — has vision) — https://console.mistral.ai/
MISTRAL_API_KEY=""

# Cerebras (TERTIARY — ultra fast) — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=""

# OpenRouter (LAST RESORT — many models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# ========== Email (Resend) ==========
# Get from: https://resend.com/api-keys
# Free tier: 100 emails/day, 3000/month
# IMPORTANT: Forgot Password emails, Weekly Digest emails
RESEND_API_KEY=""

# ========== Push Notifications (Web Push / VAPID) ==========
# Generate with: node -e "const wp=require('web-push');console.log(JSON.stringify(wp.generateVAPIDKeys()))"
# Or use this online tool: https://web-push-codelab.glitch.me/
# These are PUBLIC keys (safe to commit) but PRIVATE must be kept secret
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# ========== Optional: Native Android FCM ==========
# Required only for Admin Strict Focus commands while the Android app is closed.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Keep escaped newlines (\\n) when storing as one environment variable.
FIREBASE_PRIVATE_KEY=""

# ========== Scheduled Focus Cron ==========
# Generate with: openssl rand -hex 32
# External production scheduler calls GET/POST /api/cron/focus-schedules every minute
# with Authorization: Bearer <secret>. Development defaults to lazy; production
# defaults to external so a missing/stale heartbeat is visible in /api/health.
CRON_SECRET=""
FOCUS_SCHEDULER_MODE="external"
FOCUS_SCHEDULER_STALE_AFTER_SECONDS="180"
FOCUS_SCHEDULER_LEASE_SECONDS="120"

# ========== Optional: Error Tracking (Sentry) ==========
# Get from: https://sentry.io/
# Free tier: 5,000 events/month
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""

# ========== Optional: Distributed Rate Limiting (Upstash Redis) ==========
# auto: Redis when both credentials exist, otherwise bounded local memory.
# memory: always local. upstash: require Redis intent; missing/failing Redis is
# visible as degraded while a per-instance memory safety limiter remains active.
RATE_LIMIT_BACKEND="auto"
RATE_LIMIT_REDIS_TIMEOUT_MS="800"
RATE_LIMIT_REDIS_PREFIX="hsc-ultimate:rate-limit:v1"
# Get the REST credentials from https://upstash.com/ — never expose the token to clients.
# UPSTASH_REDIS_REST_URL="https://YOUR-DATABASE.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# ========== Optional: Analytics (Plausible) ==========
# Privacy-friendly analytics alternative to Google Analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ========== Application Settings ==========
# NODE_ENV is automatically set by Next.js (development/production/test)
# Don't set it manually unless you have a specific reason

# Application URL (used in emails, webhooks, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public, verified privacy/data-request mailbox shown on /privacy.
# Required before public launch; do not reuse a private credential-only inbox.
PRIVACY_CONTACT_EMAIL=""

# Admin email (for notifications, contact, etc.)
ADMIN_EMAIL=""
